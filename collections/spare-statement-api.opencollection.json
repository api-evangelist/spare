{
  "opencollection": "1.0.0",
  "info": {
    "name": "Information Account Statement API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Statement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download account statement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1.0/ais/Statement/File",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "query",
                "description": "Account id"
              }
            ]
          },
          "docs": "**Unique resource name :** ais.v1.statement.file\n            \n**Important!:**\n            \n- The permissions bellow are required on the consent:\n- `ReadBalances`\n- `ReadTransactionsBasic`\n- `ReadTransactionsDetail`\n- `ReadTransactionsDebits`\n- `ReadTransactionsCredits`"
        }
      ]
    }
  ],
  "bundled": true
}