        {
          "id": "9950d67b-539b-4b93-83a5-00ffac4e3e47",
          "name": "Refreshes an API authentication token using a valid refresh token.",
          "request": {
            "name": "Refreshes an API authentication token using a valid refresh token.",
            "description": {
              "content": "**Unique resource name:** api_authentication.v1.refresh\r\n            \r\nThis endpoint allows clients to obtain a new access token by providing a valid refresh token.\r\nThe refresh token must be issued by the authentication service and must not be expired.\r\n            \r\n**Authentication Process:**\r\n- The `refresh-token` header must contain a valid refresh token.\r\n- If the refresh token is valid, a new access token is issued.\r\n- If the refresh token is invalid or expired, a `401 Unauthorized` response is returned.\r\n            \r\n**Security Considerations:**\r\n- Refresh tokens should be stored securely and not shared.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1.0",
                "authentication",
                "Refresh"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The refresh token used to obtain a new access token.",
                "key": "refresh-token",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
