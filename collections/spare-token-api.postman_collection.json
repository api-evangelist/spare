        {
          "id": "05044b8d-127a-4678-89ab-ecaa59d0901a",
          "name": "Generates an API authentication token using the provided API credentials.",
          "request": {
            "name": "Generates an API authentication token using the provided API credentials.",
            "description": {
              "content": "**Unique resource name:** api_authentication.v1.token\r\n            \r\nThis endpoint authenticates an API keys by validating the provided API credentials.\r\nUpon successful authentication, an access token is generated and returned.\r\n            \r\n**Authentication Process:**\r\n- The `app-id` and `x-api-key` headers must contain valid credentials.\r\n- If authentication is successful, a signed JSON Web Token (JWT) is issued.\r\n- If authentication fails due to invalid credentials, a `401 Unauthorized` response is returned.\r\n            \r\n**Security Considerations:**\r\n- The API key (`x-api-key`) should be kept confidential.\r\n- The generated JWT should be used for subsequent authenticated requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1.0",
                "authentication",
                "Token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The unique identifier of the API keys.",
                "key": "app-id",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) The API key associated with the API keys.",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
