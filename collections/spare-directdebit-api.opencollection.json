{
  "opencollection": "1.0.0",
  "info": {
    "name": "Information Account DirectDebit API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DirectDebit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account direct debits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1.0/ais/DirectDebit/Get",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "query",
                "description": "Account id"
              }
            ]
          },
          "docs": "**Unique resource name :** ais.v1.direct_debit.get\n            \n**Important!:**\n            \nThe permissions bellow are required on the consent:\n- `ReadDirectDebits`"
        }
      ]
    }
  ],
  "bundled": true
}