                  "$ref": "#/components/schemas/TransactionResponseModelIEnumerablePagesModelMetaApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "- If consent id is not valid\r\n- If a filter model is not valid",
            "content": {
              "application/json": {
                "schema": {
